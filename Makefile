# init ОС «Чёрное Море» — теперь на Konda (основа.конда + доверенный C-шим
# конда_init.h). Собирается ТРАНСПИЛЯТОРОМ Konda: он сам зовёт cc и строит .elf
# со строгой (clean, -Werror) сборкой выхода (§65).
#
# ⚠ ПОРЯДОК СБОРКИ: init зависит от собранного транспилятора
# (Программы/ТранспиляторКонда/Собранное/ТранспиляторКонда). Оркестратор
# (Сборка/основа.c) должен построить ТранспиляторКонда ДО Инициализации.

ТРАНСПИЛЯТОР = ../ТранспиляторКонда/Собранное/ТранспиляторКонда
ИСТОЧНИК = основа.конда
ШИМ = конда_init.h
TARGET = Собранное/init

all: $(TARGET)

# stdlib Konda init не нужна (только libc/syscalls через внешняя) → --без-стандартной-библиотеки.
$(TARGET): $(ИСТОЧНИК) $(ШИМ)
	mkdir -p Собранное
	$(ТРАНСПИЛЯТОР) --без-стандартной-библиотеки $(ИСТОЧНИК)
	cp вывод/основа.elf $(TARGET)

clean:
	rm -f $(TARGET)
	rm -rf вывод

install: $(TARGET)
	install -D -m 755 $(TARGET) /sbin/init
