# init ОС «Чёрное Море» — на чистом Konda (основа.конда). C-шима больше НЕТ:
# запуск оболочки делает встроенная «заменить_образ» (§114, execvp без сырого
# char**). Собирается СИСТЕМОЙ СБОРКИ Konda (`konda build`, фронтенд сборка.elf)
# по манифесту Konda.toml: фронтенд сам зовёт транспилятор (аллокатор=libc,
# стдлиб=да), тот — cc, и строит .elf со строгой (clean, -Werror) сборкой (§65).
#
# ⚠ ПОРЯДОК СБОРКИ: init зависит и от собранного транспилятора, и от фронтенда
# konda build (../ТранспиляторКонда/сборка/вывод/сборка.elf). Оркестратор
# (Сборка/основа.c) строит ТранспиляторКонда ДО Инициализации через `make`, а его
# цель `all` собирает и фронтенд (prereq stdlib) → к моменту сборки init оба на месте.

ТРАНСПИЛЯТОР = ../ТранспиляторКонда/Собранное/ТранспиляторКонда
ФРОНТЕНД = ../ТранспиляторКонда/сборка/вывод/сборка.elf
ИСТОЧНИК = основа.конда
МАНИФЕСТ = Konda.toml
TARGET = Собранное/init

all: $(TARGET)

# konda build читает Konda.toml (имя=init → вывод/init.elf), сам находит источник
# авто-сканом. Флаги сборки (аллокатор/стдлиб) заданы В МАНИФЕСТЕ — он и Makefile
# в зависимостях: правка любого ОБЯЗАНА пересобрать .elf (иначе make оставил бы
# СТАРЫЙ бинарник, напр. с прежним jemalloc-линком → в рантайме «не найден
# libjemalloc.so.2»). --пересобрать минует хеш-кэш фронтенда: раз make уже решил,
# что цель устарела, пересобираем безусловно (кэш фронтенда — для ручных запусков).
$(TARGET): $(ИСТОЧНИК) $(МАНИФЕСТ) Makefile
	mkdir -p Собранное
	KONDA_TRANSPILER="$(abspath $(ТРАНСПИЛЯТОР))" $(ФРОНТЕНД) $(МАНИФЕСТ) --пересобрать
	cp вывод/init.elf $(TARGET)

clean:
	rm -f $(TARGET)
	rm -rf вывод

install: $(TARGET)
	install -D -m 755 $(TARGET) /sbin/init
