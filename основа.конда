// init для ОС «Чёрное Море» — порт с C на Konda.
//
// PID 1: монтирует ФС, запускает и перезапускает интерактивный shell (как getty),
// жнёт зомби-процессы и обрабатывает сигналы выключения/перезагрузки.
//
// Единственное ИЗМЕНЯЕМОЕ глобальное состояние — атом (инвариант №4 Konda: обычных
// глобальных переменных нет, гонок данных нет по построению). Обработчики сигналов
// выполняются асинхронно и трогают это состояние — атомарный доступ делает их
// безопасными без гонок (как _Atomic-переменная в C, но названной и проверенной).
//
// Секрет sigaction/siginfo (проверка uid отправителя) из C-версии здесь НЕ нужен:
// ОС однопользовательская (только root), поэтому сигналы приходят только от root —
// достаточно простого signal(). Это упрощает порт (без struct sigaction/siginfo_t).

#содержит <stdio.h>
#содержит <stdlib.h>
#содержит <unistd.h>
#содержит <signal.h>
#содержит <sys/wait.h>
#содержит <sys/reboot.h>
#содержит "конда_init.h"

// Обработчик сигнала: C-тип «void (*)(int)» — Konda-функция передаётся как есть.
типфункции ничего Обработчик(целое32)

// C-функции ядра/libc. Все — фиксированной сигнатуры (варарги execl инкапсу-
// лированы в C-шиме конда_exec_оболочку; sigaction заменён на signal).
внешняя целое32 getpid()
внешняя целое32 fork()
внешняя ничего конда_exec_оболочку()   // C-шим: execl busybox sh (не возвращается)
внешняя целое32 waitpid(целое32 пид, вывод целое32 статус, целое32 опции)
внешняя целое32 kill(целое32 пид, целое32 сигнал)
внешняя целое32 sleep(целое32 секунды)
внешняя целое32 pause()
внешняя ничего sync()
внешняя целое32 reboot(целое32 команда)
внешняя ничего _exit(целое32 код)
внешняя целое32 system(символ* команда)
внешняя Обработчик signal(целое32 сигнал, Обработчик обработчик)

// Константы Linux/x86_64 — стабильный ABI ядра (ОС принципиально x86_64-only,
// см. CLAUDE.md). Konda пока не умеет импортировать C-макросы в конст
// (нужно компайл-тайм-выражение), поэтому значения заданы явно.
конст целое32 СИГ_KILL  = 9
конст целое32 СИГ_USR1  = 10   // → halt
конст целое32 СИГ_USR2  = 12   // → poweroff
конст целое32 СИГ_TERM  = 15   // → reboot
конст целое32 СИГ_CHLD  = 17   // ребёнок завершился
конст целое32 СИГ_PWR   = 30   // → poweroff
конст целое32 БЕЗ_ОЖИДАНИЯ   = 1
// reboot(2) magic (linux/reboot.h). 0xcdef0123 не влезает в int32 — берём
// беззнаковый и приводим (важен бит-паттерн, не знак): reboot передаёт его в syscall.
конст неподписанный целое32 RB_HALT  = 3454992675   // 0xcdef0123 RB_HALT_SYSTEM
конст целое32 RB_POWEROFF            = 1126301404    // 0x4321fedc RB_POWER_OFF
конст целое32 RB_REBOOT              = 19088743      // 0x01234567 RB_AUTOBOOT

конст целое32 ВРЕМЯ_ОЖИДАНИЯ = 3

// Пид отслеживаемой оболочки. 0 — оболочка не запущена (её надо поднять).
// Обработчик SIGCHLD обнуляет при завершении, главный цикл поднимает заново.
атом<целое32> пид_оболочки = 0

// Смонтировать основные ФС из fstab (busybox mount -a).
ничего примонтировать_фс()
{
    целое32 результат = system("mount -a")
    если результат == 0 {
        printf("Инициализация: файловые системы примонтированы.\n")
    } иначе {
        printf("Инициализация: ошибка монтирования, код %d\n", результат)
    }
}

// Запустить интерактивный shell (busybox sh) через fork+execv, запомнить пид.
ничего запустить_оболочку()
{
    целое32 пид = fork()
    если пид < 0 {
        perror("Инициализация: fork")
        вернуть
    }
    если пид == 0 {
        // Дочерний процесс: заменяем образ на busybox sh (C-шим — сырой argv
        // char** инкапсулирован там, не возвращается при успехе).
        конда_exec_оболочку()
    }
    сохранить(пид_оболочки, пид, последовательный)
}

// Обработчик SIGCHLD: жнём всех завершившихся детей (иначе зомби). Если
// завершилась отслеживаемая оболочка — помечаем её пид нулём (главный цикл поднимет).
ничего обработчик_чайлд(целое32 сигнал)
{
    цикл {
        целое32 статус = 0
        целое32 завершившийся = waitpid(0 - 1, статус, БЕЗ_ОЖИДАНИЯ)
        если завершившийся <= 0 {
            прервать
        }
        если завершившийся == загрузить(пид_оболочки, последовательный) {
            сохранить(пид_оболочки, 0, последовательный)
        }
    }
}

// Обработчик выключения/перезагрузки: вежливо завершаем все процессы, ждём,
// добиваем, синхронизируем диски и вызываем reboot() с нужным действием.
ничего обработчик_выключения(целое32 сигнал)
{
    kill(0 - 1, СИГ_TERM)
    sleep(ВРЕМЯ_ОЖИДАНИЯ)
    kill(0 - 1, СИГ_KILL)
    sync()

    если сигнал == СИГ_USR1 {
        reboot(как<целое32>(RB_HALT))
    }
    если сигнал == СИГ_USR2 или сигнал == СИГ_PWR {
        reboot(RB_POWEROFF)
    }
    если сигнал == СИГ_TERM {
        reboot(RB_REBOOT)
    }
}

// Зарегистрировать обработчики сигналов.
ничего назначить_сигналы()
{
    signal(СИГ_CHLD, обработчик_чайлд)
    signal(СИГ_USR1, обработчик_выключения)
    signal(СИГ_USR2, обработчик_выключения)
    signal(СИГ_TERM, обработчик_выключения)
    signal(СИГ_PWR,  обработчик_выключения)
}

целое32 точка_входа(срез<символ*> аргументы)
{
    если getpid() != 1 {
        printf("Инициализация: PID не равен 1. Завершение.\n")
        вернуть 1
    }

    примонтировать_фс()
    назначить_сигналы()
    запустить_оболочку()

    цикл {
        pause()   // просыпаемся по любому сигналу (в т.ч. SIGCHLD)
        // Оболочка вышла (exit/крах) — поднимаем заново, как getty.
        если загрузить(пид_оболочки, последовательный) == 0 {
            sleep(1)   // анти-busy-loop, если shell падает мгновенно
            запустить_оболочку()
        }
    }

    вернуть 0
}
